{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/next",
    "ultracite/biome/react"
  ],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**/*",
      "!components/ai-elements",
      "!components/elements",
      "!components/ui",
      "!lib/utils.ts",
      "!hooks/use-mobile.ts",
      // ── ЗЕРКАЛЬНЫЕ ФАЙЛЫ СЛОЯ АРХИТЕКТОРА (137-2, 2026-09-06) ──────────────
      // Перенесены из `fractera-next-starter` ПОБАЙТНО и обязаны такими
      // остаться: сверка `diff` с источником — единственный прибор, которым
      // проверяется, что зеркало не разошлось. Правка под здешний линтер
      // сломала бы прибор навсегда, а расходятся две копии молча.
      //
      // 🔒 ЭТО ИСКЛЮЧЕНИЕ, А НЕ ДОЛГ, И РАЗНИЦА НАЗВАНА. Линтер зеркала строже
      // линтера стартера — он ловит здесь 10 замечаний (`noLeakedRender`,
      // `noArrayIndexKey`, `noJsxPropsBind`). Правило сюда не относится:
      // владелец этих файлов — соседний репозиторий, и чинить их надо ТАМ,
      // одной правкой на обе копии. Тот же приём, которым выше исключён
      // вендоренный `components/ai-elements`.
      //
      // 🛑 ЦЕНА НАЗВАНА ВСЛУХ: настоящий дефект, приехавший из источника, здесь
      // тоже не покраснеет. Поэтому список поимённый — не папка целиком, кроме
      // `components/workspace`, где зеркальны оба файла.
      // 🛑 ПУТЬ ЗАПИСАН ЧЕРЕЗ `**`, А НЕ `[lang]`, И ЭТО НЕ КОСМЕТИКА: в glob
      // квадратная скобка — класс символов, а в JSON её экранирование `\[`
      // недопустимо вовсе. Три попытки записать буквальные скобки дали отказ
      // конфигурации, то есть линтер не запускался совсем.
      //
      // 🔒 СПИСОК СТАЛ ПАПОЧНЫМ ПОСЛЕ 137-3, И ЭТО ЧЕСТНЕЕ ПОИМЁННОГО. Шапка,
      // подвал и раздел «Настройки» привезли 115 файлов из стартера; поимённый
      // список такой длины никто не станет поддерживать, и первый же
      // забытый файл сделает вердикт линтера случайным.
      "!components/workspace",
      "!components/menu",
      "!components/cart",
      "!components/dialog",
      "!components/icons",
      "!components/form",
      "!components/language-switcher.client.tsx",
      "!config",
      "!providers",
      "!lib/menu",
      "!lib/architect",
      "!lib/facts",
      "!lib/products",
      "!lib/task",
      "!lib/socials",
      "!lib/i18n",
      "!lib/roles.ts",
      "!lib/flows.ts",
      "!lib/site-urls.ts",
      "!lib/runtime-urls.ts",
      "!lib/openai-key.ts",
      "!_tools",
      "!app/**/settings/_components",
      "!app/**/settings/_i18n",
      "!app/**/settings/_lib",
      "!app/api/architect",
      // 🛑 ЭТИ ЧЕТЫРЕ — ПОИМЁННО, ПОТОМУ ЧТО ПАПКА ОБЩАЯ. `lib/fractera` и
      // `lib/auth` живут и своими файлами тоже: исключив папку целиком, я снял
      // бы линтер с кода, который здесь и написан.
      "!lib/fractera/data-service.ts",
      "!lib/fractera/knowledge.ts",
      "!lib/auth/auth-bypass.ts",
      "!lib/auth/get-session.ts",
      "!lib/auth/require-roles.ts",
      // Словари меню аккаунта — приехали хвостом `lib/menu/account-links.ts`.
      "!app/**/(protectedLayer)"
    ]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off",
        "noConsole": "off",
        "noBitwiseOperators": "off",
        "noUnnecessaryConditions": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "noNestedTernary": "off",
        "useConsistentTypeDefinitions": "off"
      },
      "nursery": {
        "useSortedClasses": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "useSimplifiedLogicExpression": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "useUniqueElementIds": "off",
        "useImageSize": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      }
    }
  }
}
